# Dev-only values (committed). Prod uses .env.prod + Docker secrets.
SERVICE_NAME=offers
GRPC_PORT=50051
ADMIN_PORT=8081
LOG_LEVEL=debug
GRPC_REFLECTION=true
DATABASE_URL=postgres://offers:offers-dev@postgres:5432/offers?sslmode=disable
REDIS_CACHE_URL=redis://redis-cache:6379/0
REDIS_STATE_URL=redis://redis-state:6379/0
AI_GRPC_ADDR=ai:50051
NOTIFIER_GRPC_ADDR=notifier:50051
