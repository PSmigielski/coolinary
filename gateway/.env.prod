# Prod settings (committed, no secrets).
SERVICE_NAME=gateway
HTTP_PORT=3000
ADMIN_PORT=8081
REDIS_CACHE_URL=redis://redis-cache:6379/0
REDIS_STATE_URL=redis://redis-state:6379/0
IDENTITY_HTTP_URL=http://identity:3000
IDENTITY_GRPC_ADDR=identity:50051
NOTIFIER_GRPC_ADDR=notifier:50051
KITCHEN_GRPC_ADDR=kitchen:50051
PLANNER_GRPC_ADDR=planner:50051
OFFERS_GRPC_ADDR=offers:50051
AI_GRPC_ADDR=ai:50051
LOG_LEVEL=info
# AUTH_ISSUER is set in docker-compose.prod.yml from DOMAIN.
