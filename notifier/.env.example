# notifier settings. Any X can be given as X_FILE (path to a file), used for Docker secrets.
SERVICE_NAME=notifier
GRPC_PORT=50051
ADMIN_PORT=8081
REDIS_CACHE_URL=redis://redis-cache:6379/0
REDIS_STATE_URL=redis://redis-state:6379/0
MAIL_FROM=Coolinary <hello@coolinary.app>
LOG_LEVEL=info
GRPC_REFLECTION=false
DATABASE_URL=postgres://notifier:<password>@postgres:5432/notifier
SMTP_URL=smtp://user:pass@smtp.example.com:587
