# Dev-only values (committed). Prod uses .env.prod + Docker secrets.
SERVICE_NAME=notifier
GRPC_PORT=50051
ADMIN_PORT=8081
REDIS_CACHE_URL=redis://redis-cache:6379/0
REDIS_STATE_URL=redis://redis-state:6379/0
MAIL_FROM=Coolinary <hello@coolinary.app>
LOG_LEVEL=debug
GRPC_REFLECTION=true
DATABASE_URL=postgres://notifier:notifier-dev@postgres:5432/notifier
SMTP_URL=smtp://mailpit:1025
