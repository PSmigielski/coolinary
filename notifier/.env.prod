# Prod settings (committed, no secrets).
SERVICE_NAME=notifier
GRPC_PORT=50051
ADMIN_PORT=8081
REDIS_CACHE_URL=redis://redis-cache:6379/0
REDIS_STATE_URL=redis://redis-state:6379/0
MAIL_FROM=Coolinary <hello@coolinary.app>
LOG_LEVEL=info
GRPC_REFLECTION=false
DATABASE_URL_FILE=/run/secrets/notifier_database_url
SMTP_URL_FILE=/run/secrets/smtp_url
