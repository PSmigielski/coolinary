{
  "name": "@coolinary/notifier",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts src/healthcheck.ts --target=bun --outdir=dist --sourcemap=linked",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --error-on-warnings && tsc --noEmit",
    "lint:fix": "biome check --write",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@grpc/grpc-js": "1.14.7",
    "@grpc/proto-loader": "0.8.1",
    "@grpc/reflection": "1.0.4",
    "drizzle-orm": "0.45.4",
    "nodemailer": "10.3.1",
    "prom-client": "15.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/bun": "1.4.4",
    "@types/nodemailer": "8.0.2",
    "drizzle-kit": "0.31.11",
    "typescript": "7.0.2"
  }
}
