# Prod settings (committed, no secrets). Secrets come from /run/secrets via *_FILE.
SERVICE_NAME=kitchen
GRPC_PORT=50051
ADMIN_PORT=8081
LOG_LEVEL=info
GRPC_REFLECTION=false
DATABASE_URL_FILE=/run/secrets/kitchen_database_url
REDIS_CACHE_URL=redis://redis-cache:6379/0
REDIS_STATE_URL=redis://redis-state:6379/0
AI_GRPC_ADDR=ai:50051
NOTIFIER_GRPC_ADDR=notifier:50051
