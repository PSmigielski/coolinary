# planner service settings. Any X can be given as X_FILE (path to a file), used for Docker secrets.
SERVICE_NAME=planner
GRPC_PORT=50051
ADMIN_PORT=8081
LOG_LEVEL=info
# Turn on gRPC server reflection (dev only).
GRPC_REFLECTION=false
DATABASE_URL=postgres://planner:<password>@postgres:5432/planner?sslmode=disable
REDIS_CACHE_URL=redis://redis-cache:6379/0
REDIS_STATE_URL=redis://redis-state:6379/0
KITCHEN_GRPC_ADDR=kitchen:50051
OFFERS_GRPC_ADDR=offers:50051
AI_GRPC_ADDR=ai:50051
