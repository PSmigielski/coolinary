# Prod settings (committed, no secrets).
SERVICE_NAME=ai
GRPC_PORT=50051
ADMIN_PORT=8081
REDIS_CACHE_URL=redis://redis-cache:6379/0
# Only "stub" exists until an LLM provider is chosen (see src/coolinary_ai/llm/).
LLM_PROVIDER=stub
LANGFUSE_BASE_URL=http://langfuse-web:3000
ENVIRONMENT=prod
LOG_LEVEL=info
GRPC_REFLECTION=false
LANGFUSE_PUBLIC_KEY_FILE=/run/secrets/langfuse_public_key
LANGFUSE_SECRET_KEY_FILE=/run/secrets/langfuse_secret_key
TRACE_HASH_SALT_FILE=/run/secrets/trace_hash_salt
