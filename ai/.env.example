# ai settings. Any X can be given as X_FILE (path to a file), used for Docker secrets.
SERVICE_NAME=ai
GRPC_PORT=50051
ADMIN_PORT=8081
REDIS_CACHE_URL=redis://redis-cache:6379/0
# "stub" (rules and fixtures, no API calls) or "anthropic" (Claude API).
LLM_PROVIDER=stub
# Required when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=sk-ant-...
# Job registry: model, effort and limits per job (default: jobs.toml next to the code).
# AI_JOBS_FILE=
# Per-job overrides win over the file, e.g. AI_JOB_PHOTO_TO_ITEMS_ENABLED=false,
# AI_JOB_COMPOSE_DAY_PLAN_MODEL=claude-sonnet-5-5, AI_JOB_MODIFY_MEAL_EFFORT=medium.
# Rate for cost in euros.
AI_USD_TO_EUR=0.92
LANGFUSE_BASE_URL=http://langfuse-web:3000
ENVIRONMENT=prod
LOG_LEVEL=info
GRPC_REFLECTION=false
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# Salt for hashing household ids in traces.
TRACE_HASH_SALT=<random>
