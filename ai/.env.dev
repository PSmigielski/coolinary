# Dev-only values (committed). Prod uses .env.prod + Docker secrets.
SERVICE_NAME=ai
GRPC_PORT=50051
ADMIN_PORT=8081
REDIS_CACHE_URL=redis://redis-cache:6379/0
# Only "stub" exists until an LLM provider is chosen (see src/coolinary_ai/llm/).
LLM_PROVIDER=stub
LANGFUSE_BASE_URL=http://langfuse-web:3000
ENVIRONMENT=dev
LOG_LEVEL=debug
GRPC_REFLECTION=true
# Created on first boot by LANGFUSE_INIT_* (platform/langfuse/langfuse.dev.env).
LANGFUSE_PUBLIC_KEY=pk-lf-coolinary-dev
LANGFUSE_SECRET_KEY=sk-lf-coolinary-dev
TRACE_HASH_SALT=coolinary-dev
