# Dev-only values (committed). Prod uses .env.prod + Docker secrets.
SERVICE_NAME=ai
GRPC_PORT=50051
ADMIN_PORT=8081
REDIS_CACHE_URL=redis://redis-cache:6379/0
# Dev, tests and CI never call Claude: the stub answers from rules and fixtures.
LLM_PROVIDER=stub
# Job registry: model, effort and limits per job (default: jobs.toml next to the code).
# AI_JOBS_FILE=
# Per-job overrides win over the file, e.g. AI_JOB_PHOTO_TO_ITEMS_ENABLED=false,
# AI_JOB_COMPOSE_DAY_PLAN_MODEL=claude-sonnet-5-5, AI_JOB_MODIFY_MEAL_EFFORT=medium.
# Rate for cost in euros.
AI_USD_TO_EUR=0.92
LANGFUSE_BASE_URL=http://langfuse-web:3000
ENVIRONMENT=dev
LOG_LEVEL=debug
GRPC_REFLECTION=true
# Created on first boot by LANGFUSE_INIT_* (platform/langfuse/langfuse.dev.env).
LANGFUSE_PUBLIC_KEY=pk-lf-coolinary-dev
LANGFUSE_SECRET_KEY=sk-lf-coolinary-dev
TRACE_HASH_SALT=coolinary-dev
