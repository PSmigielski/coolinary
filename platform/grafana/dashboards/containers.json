    {
      "type": "table",
      "title": "Container lifecycle (selected time range)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "cAdvisor has no restart counter, so these are derived. Age: time since the current container was created (cAdvisor reports creation time, so an in-place restart does not reset it). Restarts: resets of the container's CPU counter in the time range, which catches in-place restarts (crash loops, docker restart). Containers seen: more than 1 means the service was recreated (compose up with a new image or config) during the range.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "time() - max by (container_label_com_docker_compose_service) (container_start_time_seconds{container_label_com_docker_compose_project=\"coolinary\", container_label_com_docker_compose_service=~\"$service\"})",
          "legendFormat": "",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "max by (container_label_com_docker_compose_service) (resets(container_cpu_usage_seconds_total{container_label_com_docker_compose_project=\"coolinary\", container_label_com_docker_compose_service=~\"$service\"}[$__range]))",
          "legendFormat": "",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "count by (container_label_com_docker_compose_service) (max_over_time(container_start_time_seconds{container_label_com_docker_compose_project=\"coolinary\", container_label_com_docker_compose_service=~\"$service\"}[$__range]))",
          "legendFormat": "",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "container_label_com_docker_compose_service": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3
            },
            "renameByName": {
              "container_label_com_docker_compose_service": "Service",
              "Value #A": "Age",
              "Value #B": "Restarts",
              "Value #C": "Containers seen"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Service"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
