{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "household.snapshot v1",
  "description": "The household's current state, republished on request (IDN-01-04). An upsert by household_id.",
  "type": "object",
  "properties": {
    "household_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "description": "The household the event is about."
    },
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "plus"
      ]
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "member_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "The member: one person in one household, with or without an account."
          },
          "user_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}$"
              },
              {
                "type": "null"
              }
            ],
            "description": "The member's account, or null for a profile."
          },
          "has_account": {
            "type": "boolean",
            "description": "True for owner and member, false for a profile."
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "member",
              "profile"
            ],
            "description": "owner and member have an account; a profile is a person without one (a child, someone without a phone)."
          }
        },
        "required": [
          "member_id",
          "user_id",
          "has_account",
          "role"
        ],
        "additionalProperties": false
      },
      "description": "Every member: accounts and profiles."
    }
  },
  "required": [
    "household_id",
    "plan",
    "members"
  ],
  "additionalProperties": false
}
