{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "household.created v1",
  "description": "A household was created. Its owner's household.member_added follows in the same transaction.",
  "type": "object",
  "properties": {
    "household_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "description": "The household the event is about."
    },
    "owner_user_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "description": "The account that owns the new household."
    },
    "owner_member_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "description": "The owner's member id in the new household."
    }
  },
  "required": [
    "household_id",
    "owner_user_id",
    "owner_member_id"
  ],
  "additionalProperties": false
}
