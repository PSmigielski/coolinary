{
  "info": {
    "title": "Coolinary API",
    "description": "Public API used by the Coolinary app.",
    "version": "0.1.0"
  },
  "openapi": "3.1.2",
  "paths": {
    "/v1/system/status": {
      "get": {
        "summary": "Health of every back-end service, checked over gRPC",
        "tags": [
          "system"
        ],
        "responses": {
          "200": {
            "description": "Response for status 200",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "gateway",
                    "services",
                    "stores",
                    "checkedAt"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "gateway": {
                      "type": "string"
                    },
                    "services": {
                      "type": "object",
                      "patternProperties": {
                        "^(.*)$": {
                          "type": "string"
                        }
                      }
                    },
                    "stores": {
                      "type": "object",
                      "required": [
                        "redisCache",
                        "redisState"
                      ],
                      "properties": {
                        "redisCache": {
                          "type": "string"
                        },
                        "redisState": {
                          "type": "string"
                        }
                      }
                    },
                    "checkedAt": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "operationId": "getV1SystemStatus"
      }
    },
    "/v1/products/{ean}": {
      "get": {
        "summary": "Look up a scanned barcode",
        "tags": [
          "kitchen"
        ],
        "parameters": [
          {
            "name": "ean",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^[0-9]{8,14}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Response for status 200",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ean",
                    "name",
                    "brand",
                    "source"
                  ],
                  "properties": {
                    "ean": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "brand": {
                      "type": "string"
                    },
                    "packSize": {
                      "type": "object",
                      "required": [
                        "value",
                        "unit"
                      ],
                      "properties": {
                        "value": {
                          "type": "number"
                        },
                        "unit": {
                          "type": "string"
                        }
                      }
                    },
                    "source": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Response for status 400",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Response for status 404",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "502": {
            "description": "Response for status 502",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "operationId": "getV1ProductsByEan"
      }
    },
    "/v1/me": {
      "get": {
        "summary": "The signed-in user, from the JWT",
        "tags": [
          "identity"
        ],
        "responses": {
          "200": {
            "description": "Response for status 200",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id",
                    "plan"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "email": {
                      "type": "string"
                    },
                    "householdId": {
                      "type": "string"
                    },
                    "plan": {
                      "type": "string",
                      "enum": [
                        "free",
                        "plus"
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Response for status 401",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "operationId": "getV1Me"
      }
    },
    "/v1/household": {
      "get": {
        "summary": "The signed-in user's household (identity over gRPC)",
        "tags": [
          "identity"
        ],
        "responses": {
          "200": {
            "description": "Response for status 200",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id",
                    "name",
                    "plan",
                    "members"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "plan": {
                      "type": "string"
                    },
                    "members": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "displayName",
                          "role",
                          "hasAccount"
                        ],
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "displayName": {
                            "type": "string"
                          },
                          "role": {
                            "type": "string"
                          },
                          "hasAccount": {
                            "type": "boolean"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Response for status 401",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Response for status 404",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "502": {
            "description": "Response for status 502",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "operationId": "getV1Household"
      }
    }
  },
  "components": {
    "schemas": {}
  }
}
