# Compose-level settings, committed. Project names are set in the compose files (dev: coolinary, prod: coolinary-prod). Service settings live in each service's .env.dev / secrets.

# Network: one /24, see docs/infrastructure.md for the address table.
NET_PREFIX=10.77.0

# Image tag for prod builds.
TAG=latest

# Runtimes (passed to Dockerfiles as build args)
GO_VERSION=1.27
BUN_VERSION=1.4.4
PYTHON_VERSION=3.14
UV_VERSION=0.13
AIR_VERSION=v1.67.4
DELVE_VERSION=v1.27.2
BUF_VERSION=1.75.0

# Third-party images
POSTGRES_IMAGE=postgres:18
REDIS_IMAGE=redis:8
MAILPIT_IMAGE=axllent/mailpit:v1.32
CADDY_IMAGE=caddy:2
PROMETHEUS_IMAGE=prom/prometheus:v3.15.1
GRAFANA_IMAGE=grafana/grafana:13.3.0
CADVISOR_IMAGE=ghcr.io/google/cadvisor:v0.60.6
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.10.2
POSTGRES_EXPORTER_IMAGE=quay.io/prometheuscommunity/postgres-exporter:v0.19.1
REDIS_EXPORTER_IMAGE=oliver006/redis_exporter:v1.80.0
LANGFUSE_IMAGE=langfuse/langfuse:4
LANGFUSE_WORKER_IMAGE=langfuse/langfuse-worker:4
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:26.3
SEAWEEDFS_IMAGE=chrislusf/seaweedfs:4.00

# Prod domain served by Caddy (api., grafana., langfuse. subdomains)
DOMAIN=coolinary.localhost

# Dev: host port for the gateway (container port is 3000). Phones on the LAN use http://<this-machine>:<port>.
GATEWAY_HOST_PORT=3080
