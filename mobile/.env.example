# Gateway base URL used by the app (inlined into the bundle, so never put secrets here).
# Use this machine's LAN IP (not localhost: the phone running Expo Go is a different device)
# and the GATEWAY_HOST_PORT from the repo-root .env (3080 by default).
# Find your LAN IP with: ip -4 route get 1.1.1.1 | awk '{print $7}'
# Per-machine overrides go in .env.local (git-ignored).
EXPO_PUBLIC_API_URL=http://192.168.1.43:3080
