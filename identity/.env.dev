# Dev-only values (committed). Prod uses .env.prod + Docker secrets.
SERVICE_NAME=identity
HTTP_PORT=3000
GRPC_PORT=50051
ADMIN_PORT=8081
REDIS_CACHE_URL=redis://redis-cache:6379/0
REDIS_STATE_URL=redis://redis-state:6379/0
NOTIFIER_GRPC_ADDR=notifier:50051
LOG_LEVEL=debug
GRPC_REFLECTION=true
DATABASE_URL=postgres://identity:identity-dev@postgres:5432/identity
BETTER_AUTH_URL=http://localhost:3080
BETTER_AUTH_SECRET=dev-only-better-auth-secret-change-me-0123456789
TRUSTED_ORIGINS=coolinary://,exp://,http://localhost:3080,http://localhost:8081
