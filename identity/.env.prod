# Prod settings (committed, no secrets). BETTER_AUTH_URL is set in docker-compose.prod.yml from DOMAIN.
SERVICE_NAME=identity
HTTP_PORT=3000
GRPC_PORT=50051
ADMIN_PORT=8081
REDIS_CACHE_URL=redis://redis-cache:6379/0
REDIS_STATE_URL=redis://redis-state:6379/0
NOTIFIER_GRPC_ADDR=notifier:50051
LOG_LEVEL=info
GRPC_REFLECTION=false
DATABASE_URL_FILE=/run/secrets/identity_database_url
BETTER_AUTH_SECRET_FILE=/run/secrets/better_auth_secret
TRUSTED_ORIGINS=coolinary://
