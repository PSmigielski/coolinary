{
  "name": "@coolinary/identity",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts src/healthcheck.ts --target=bun --outdir=dist --sourcemap=linked",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --error-on-warnings && tsc --noEmit",
    "lint:fix": "biome check --write",
    "auth:schema": "DATABASE_URL=postgres://x@localhost/x BETTER_AUTH_URL=http://localhost BETTER_AUTH_SECRET=placeholder bun --bun x @better-auth/cli@1.4.21 generate --config src/auth.ts --output src/db/auth-schema.ts --yes",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.14",
    "@bufbuild/protobuf": "2.16.0",
    "@grpc/grpc-js": "1.14.7",
    "@grpc/proto-loader": "0.8.1",
    "@grpc/reflection": "1.0.4",
    "better-auth": "1.7.14",
    "drizzle-orm": "0.45.4",
    "elysia": "1.4.30",
    "prom-client": "15.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/bun": "1.4.4",
    "drizzle-kit": "0.31.11",
    "typescript": "7.0.2"
  }
}
