# identity settings. Any X can be given as X_FILE (path to a file), used for Docker secrets.
SERVICE_NAME=identity
HTTP_PORT=3000
GRPC_PORT=50051
ADMIN_PORT=8081
REDIS_CACHE_URL=redis://redis-cache:6379/0
REDIS_STATE_URL=redis://redis-state:6379/0
NOTIFIER_GRPC_ADDR=notifier:50051
LOG_LEVEL=info
GRPC_REFLECTION=false
DATABASE_URL=postgres://identity:<password>@postgres:5432/identity
# Public URL of the API (the gateway), e.g. https://api.example.com
BETTER_AUTH_URL=https://api.example.com
# 32+ random bytes, e.g. openssl rand -base64 32
BETTER_AUTH_SECRET=<secret>
# Comma-separated origins allowed to call auth endpoints (app scheme, web origins)
TRUSTED_ORIGINS=coolinary://
